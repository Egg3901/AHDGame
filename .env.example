# =============================================================================
# A House Divided — Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values.
# Generate random secrets with: openssl rand -hex 32
# =============================================================================

# ─── Game Configuration ─────────────────────────────────────────────────────
# These values control the visible provenance of the game world.
# GAME_START_DATE is stamped on user-created wiki pages and other in-world
# content to establish the canonical start year of the simulation.
# GAME_ITERATION is displayed in the UI to identify the current release cycle.
GAME_START_DATE=2020
GAME_ITERATION=beta

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection string.
# Production:  your Atlas cluster URI or Railway-hosted MongoDB instance.
# Staging:     a SEPARATE Atlas cluster or database (never share with production).
# Local:       mongodb://localhost:27017/a-house-divided
MONGODB_URI=mongodb://localhost:27017/a-house-divided

# Optional explicit MongoDB database name override. When omitted, the app uses
# the database embedded in MONGODB_URI. Useful when sandbox and production
# share a cluster but must stay isolated by database name.
# MONGODB_DB=a-house-divided-sandbox
# Legacy alias also accepted by runtime code: MONGO_DB_NAME

# ─── Authentication & Security ────────────────────────────────────────────────
# JWT signing secret used by NextAuth.js. MUST be unique per environment
# (local / staging / production).
AUTH_SECRET=your-jwt-secret-here

# The public URL of the application. NextAuth uses this to construct
# callback URLs and redirect paths.
NEXTAUTH_URL=http://localhost:3000

# Key required to register the first admin account via the setup page.
ADMIN_REGISTRATION_KEY=your-admin-key

# Secret used to authenticate scheduled cron job requests.
CRON_SECRET=your-cron-secret

# Internal API key used by server-side scripts and the task management API.
INTERNAL_API_KEY=your-internal-api-key-here

# ─── GitHub Integration ───────────────────────────────────────────────────────
# Personal access token and repository slug for creating GitHub issues
# from in-game bug reports and feedback submissions.
# GIT_TOKEN=ghp_...
# GITHUB_REPO=owner/repo  (e.g. Egg3901/a-house-divided)

# ─── Error Monitoring (Sentry) ────────────────────────────────────────────────
# Sentry-compatible DSNs for crash reporting (Sentry SaaS or GlitchTip).
# NEXT_PUBLIC_SENTRY_DSN is required for browser-side website issues.
# SENTRY_DSN is used by server/edge code; it can usually match the public DSN.
# Use a separate project per environment (local / staging / production).
# NEXT_PUBLIC_SENTRY_DSN=https://public-key@your-sentry-or-glitchtip-host/project-id
# SENTRY_DSN=https://public-key@your-sentry-or-glitchtip-host/project-id
# SENTRY_ORG=ahousedivided   (organization slug from URL — not the same as project name)
# SENTRY_PROJECT=a-house-divided
# SENTRY_AUTH_TOKEN=sntrys_eyJ...  (build plugin + API; alias: SENTRY_TOKEN)


# ─── OAuth Providers ───────────────────────────────────────────────────────────
# Discord OAuth (enables "Continue with Discord" login/register + account linking)
# Create an app at https://discord.com/developers/applications
# Redirect URI must match the environment exactly:
#   Local:   http://localhost:3000/api/auth/discord/callback
#   Staging: https://your-staging-url.vercel.app/api/auth/discord/callback
#   Prod:    https://www.ahousedividedgame.com/api/auth/discord/callback
# DISCORD_CLIENT_ID=your-discord-app-client-id
# DISCORD_CLIENT_SECRET=your-discord-app-client-secret
# DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Google OAuth (enables "Continue with Google" login/register + account linking)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Redirect URI must match the environment exactly (same rule as Discord above)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Cloudflare Turnstile CAPTCHA on registration (fails open — registration works
# without these set, just without the challenge). Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile — NEXT_PUBLIC_TURNSTILE_SITE_KEY
# is exposed to the browser by design (that's what "site key" means); keep
# TURNSTILE_SECRET_KEY server-only.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ─── Storage & Uploads ─────────────────────────────────────────────────────────
# Vercel Blob storage (legacy — migrating to Cloudflare R2)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Cloudflare R2 storage for image uploads.
# Without this, uploads fall back to local /uploads directory (fine for local dev)
# CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
# CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key
# CLOUDFLARE_R2_BUCKET_NAME=ahousedivided
# CLOUDFLARE_R2_PUBLIC_URL=https://cdn.ahousedividedgame.com

# ─── Monetization & Ads ───────────────────────────────────────────────────────
# Override the Patreon membership page URL shown in the UI
# NEXT_PUBLIC_PATREON_URL=https://www.patreon.com/cw/AHouseDividedGame/membership

# Patreon CREATOR access token used by the supporter reconciler cron to list all
# campaign members (paid + free). Scopes: identity[email], campaigns,
# campaigns.members[.email]. Required for /api/cron/patreon-reconcile; the route
# throws loudly if it is unset. Distinct from PATREON_WEBHOOK_SECRET.
# PATREON_CREATOR_TOKEN=your-patreon-creator-access-token
# Optional: pin the campaign id (auto-discovered from the token when unset).
# PATREON_CAMPAIGN_ID=1234567
#
# Reconcile cron: GET|POST /api/cron/patreon-reconcile with
#   Authorization: Bearer $CRON_SECRET
# DRY RUN by default (computes toGrant/toDerole/unmatched/expired, writes nothing).
# Pass ?apply=true to actually grant roles, start grace periods, and expire.

# AdSense publisher client ID used for the standard page-level tag.
# Privacy & messaging messages serve from the AdSense tag when the site is
# configured in the same account. Leave unset locally if you want to keep using
# the built-in fallback cookie banner instead.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-1071118423453855

# ─── Registration Control ─────────────────────────────────────────────────────
# Required for new registrations when test mode is enabled via the admin panel
# TEST_SECRET=your-test-secret-here

# ─── E2E Testing ──────────────────────────────────────────────────────────────
# E2E_TEST_EMAIL=your-test-user@example.com
# E2E_TEST_PASSWORD=your-test-password

# ─── Sandbox / Main Site Toggle ───────────────────────────────────────────────
# Controls the "Switch to Sandbox / Main Site" link in the settings dropdown.
# NEXT_PUBLIC_MAIN_SITE_URL=https://ahousedividedgame.com
# NEXT_PUBLIC_SANDBOX_URL=https://sandbox.ahousedividedgame.com

# ─── Deployment Platform (Railway) ────────────────────────────────────────────
# Tokens and identifiers for the Railway deployment environment.
# These are used by CLI tooling, health checks, and deployment hooks.
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PROJECT_ID=your-project-id
# RAILWAY_PROJECT_TOKEN=your-project-token
# RAILWAY_PAT_TOKEN=your-personal-access-token

# ─── Transactional Email (Resend) ─────────────────────────────────────────────
# Used for password reset emails. When unset, sendEmail degrades to a
# "not configured" no-op and the forgot-password flow still queues Discord DMs.
# RESEND_API_KEY=your-resend-api-key
# EMAIL_FROM=A House Divided <no-reply@ahousedividedgame.com>

# ─── Deployment-specific URLs (all optional) ─────────────────────────────────
# Staff navbar links to an external operations dashboard; links hide when unset.
# NEXT_PUBLIC_OPS_DASHBOARD_URL=https://ops.example.com
# Staff navbar docs link; defaults to the public docs site when unset.
# NEXT_PUBLIC_DOCS_URL=https://docs.lakesidegames.net
# Sentry-compatible ingest for build-time sourcemap upload; unset disables upload.
# SENTRY_URL=https://your-sentry-or-glitchtip-host/
