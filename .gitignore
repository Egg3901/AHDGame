.trae/
.superpowers/

# Generated audit reports (reproducible from scripts/audit/)
scripts/audit/report-*.md

# Discord bot
discord-bot/node_modules/
discord-bot/dist/
discord-bot/.env
# Scratch dir for one-off scripts, dev screenshots, ops backups —
# nothing here should be checked in. Archive real artifacts under
# docs/archive/incidents|operations/<YYYY-MM>/ instead.
tmp/**

# Design bundles fetched from claude.ai/design — local reference only
.design-bundle/
# docs/ stays local-only except the generated design-system artifact
# (gitignore cannot re-include a file under an excluded directory, hence docs/*)
docs/*
!docs/DESIGN.md
savant-protocol
savant-protocol

# Generated event image contact sheet (dev-only)
scripts/event-image-gallery.html

# Wikimedia-sourced landing bento card images (binaries; upload script + manifest are tracked)
scripts/landing-images/*
!scripts/landing-images/manifest.json

.superpowers/
