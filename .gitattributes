# Enforce LF line endings for all text files regardless of platform
# (overrides per-developer core.autocrlf settings; prevents Prettier
# format:check from failing on Windows checkouts that get CRLF).
* text=auto eol=lf

# Explicit text — keep LF
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.svg       text eol=lf

# Binary — never touch line endings
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.pdf       binary
*.zip       binary
