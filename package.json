{
  "name": "a-house-divided",
  "version": "1.1.5",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "design:build": "node scripts/build-design-md.mjs",
    "design:check": "node scripts/build-design-md.mjs --check",
    "build": "next build && tsx scripts/postbuild-quality.ts",
    "start": "next start",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check . --cache --cache-location node_modules/.cache/prettier/.prettier-cache",
    "prepare": "husky",
    "generate:composition": "npx tsx scripts/generate-composition-weights.ts",
    "seed": "npx tsx scripts/seed/seed.ts",
    "seed:reset": "npx tsx scripts/seed/seed.ts --reset",
    "seed:all": "npm run seed && npm run seed:legislation && npm run seed:policies && npm run seed:demographics && npm run seed:uk",
    "bootstrap:full": "npx tsx scripts/world/bootstrap-full.ts",
    "bootstrap:vacant": "npx tsx scripts/world/bootstrap-full.ts --mode=vacant",
    "reset-and-bootstrap": "npx tsx scripts/world/reset-and-bootstrap.ts",
    "reset-and-bootstrap:vacant": "npx tsx scripts/world/reset-and-bootstrap.ts --mode=vacant",
    "seed:legislation": "npx tsx scripts/seed/seed-legislation.ts",
    "seed:legislation:reset": "npx tsx scripts/seed/seed-legislation.ts --reset-committees",
    "seed:policies": "npx tsx scripts/seed/seed-policies.ts",
    "seed:policies:reset": "npx tsx scripts/seed/seed-policies.ts --reset",
    "seed:demographics": "npx tsx scripts/seed/seed-demographics.ts",
    "seed:budgets": "npx tsx scripts/seed/seedBudgets.ts",
    "seed:uk": "npx tsx scripts/seed/seed-uk.ts",
    "seed:de": "npx tsx scripts/seed/seed-de.ts",
    "seed:imf": "npx tsx scripts/seed/seed-imf-institution.ts",
    "seed:state-sector-specializations": "npx tsx scripts/seed/seed-state-sector-specializations.ts",
    "seed:wiki": "npx tsx scripts/seed/seed-wiki.ts",
    "seed:wiki:force": "npx tsx scripts/seed/seed-wiki.ts --force",
    "migrate:npp-avatars": "npx tsx scripts/migrations/backfill-npp-avatars.ts",
    "migrate:fix-character-userid-index": "npx tsx scripts/migrations/fix-characters-userid-index.ts",
    "migrate:sovereign-crises": "npx tsx scripts/migrations/migrate-sovereign-crises.ts",
    "migrate:perf-indexes": "npx tsx scripts/migrations/add-perf-indexes.ts",
    "migrate:metric-effects": "npx tsx scripts/backfill-metric-effects.ts",
    "migrate:metric-effects:dry": "npx tsx scripts/backfill-metric-effects.ts --dry-run",
    "migrate": "npx tsx scripts/run-migrations.ts",
    "migrate:dry-run": "npx tsx scripts/run-migrations.ts --dry-run",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit",
    "knip": "knip",
    "knip:production": "knip --production",
    "verify": "concurrently --kill-others-on-fail -n lint,fmt,tsc,arch -c auto \"npm run lint\" \"npm run format:check\" \"npm run typecheck\" \"npm run architecture:audit\" && npm run test:run",
    "verify:serial": "npm run lint && npm run format:check && npm run typecheck && npm run architecture:audit && npm run test:run",
    "test:performance": "vitest run src/app/api/performance",
    "test:e2e": "playwright test",
    "test:e2e:performance": "playwright test e2e/performance.spec.ts",
    "simulate": "npx tsx scripts/simulate-legislation.ts",
    "simulate:industrial-relations": "npx tsx scripts/simulate-industrial-relations.ts",
    "sim:setup": "bash scripts/sim/local-setup.sh",
    "sim:worker": "bash scripts/sim/start-worker.sh",
    "sim:mcp": "npx tsx scripts/sim/localWorldsimMcp.ts",
    "architecture:audit": "node scripts/architecture-audit.mjs",
    "verify:build": "next build"
  },
  "lint-staged": {
    "*.{ts,tsx,mts}": [
      "eslint --fix --cache --cache-location node_modules/.cache/eslint",
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "prettier --write"
    ],
    "src/{app/globals.css,components/ui/**/*}": [
      "node scripts/build-design-md.mjs",
      "git add docs/DESIGN.md"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1054.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/source-sans-3": "^5.2.9",
    "@sentry/nextjs": "^10.69.0",
    "@thumbmarkjs/thumbmarkjs": "^1.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^1.3.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "hast-util-to-html": "^9.0.5",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.25.0",
    "mongodb": "^7.4.0",
    "next": "^16.2.12",
    "next-intl": "^4.13.6",
    "node-cron": "^4.2.1",
    "polygon-clipping": "^0.15.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "topojson-client": "^3.1.0",
    "westminster-svg": "^2.0.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "d3-color": ">=3.1.0",
    "picomatch": ">=4.0.0",
    "yaml": ">=2.8.3",
    "shell-quote": ">=1.9.0",
    "postcss": ">=8.5.18",
    "@opentelemetry/core": ">=2.8.0",
    "js-yaml": "^4.3.1",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@5": "^5.0.9",
    "fast-uri": "^3.1.5",
    "sharp": "^0.35.3",
    "@babel/core": "^7.29.7",
    "vite": ">=8.0.16"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-server": "^3.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.3",
    "d3-geo": "^3.1.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.10.2",
    "husky": "^9.1.7",
    "knip": "^6.14.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "topojson-server": "^3.0.1",
    "tsx": "^4.23.5",
    "typescript": "6.0.2",
    "vitest": "^4.1.10"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
