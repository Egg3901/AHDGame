# react-simple-maps@3.0.0 declares peer react@^16.8.0||17.x||18.x; project uses React 19.
# Ignoring peer deps allows install; the package works with React 19.
legacy-peer-deps=true

# Refuse to resolve package versions published within the last 7 days
# (npm 11.6+ / pnpm; older clients ignore unknown keys harmlessly)
min-release-age = 7
